# Copy to .env.local and fill in. Never commit real values.

# Database
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Signs admin sessions. Generate with: openssl rand -base64 48
JWT_SECRET=

# Used only by `npm run create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Contact form and replies (Gmail app password)
EMAIL_USER=
EMAIL_PASSWORD=
NOTIFICATION_EMAIL=

# Chatbot (https://build.nvidia.com)
NVIDIA_API_KEY=

# Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public address, used for SEO metadata, the sitemap and chatbot links
NEXT_PUBLIC_SITE_URL=https://zahidfarooq.com
